{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yuatom/stock-market-data/schemas/dynamic-candidate-request.schema.json",
  "title": "Dynamic Opportunity Candidate Market Data Request",
  "type": "object",
  "required": ["schema_version", "request_id", "requested_at", "trade_date", "stage", "research_repository", "research_repository_commit_sha", "market_data_contract_sha", "candidate_symbols"],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "requested_at": {"type": "string", "format": "date-time"},
    "trade_date": {"type": "string", "format": "date"},
    "stage": {"enum": ["open_30m", "close"]},
    "research_repository": {"const": "yuatom/stock-dairy"},
    "research_repository_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "market_data_contract_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_symbols": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9.-]{0,9}$"}
    },
    "transaction_id": {"type": ["string", "null"], "minLength": 1}
  },
  "additionalProperties": false
}
