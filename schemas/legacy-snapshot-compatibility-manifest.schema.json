{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.yuatom.dev/legacy-snapshot-compatibility-manifest.schema.json",
  "title": "Non-authoritative Legacy Snapshot Compatibility Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_schema_version",
    "original_path",
    "original_blob_sha",
    "original_schema_sha",
    "current_schema_sha",
    "original_raw_schema_status",
    "current_compatibility_status_before",
    "derived_content_sha256",
    "transform_version",
    "transformed_at",
    "historical_first_known_time",
    "exact_changed_json_pointers",
    "before_values",
    "after_values",
    "semantic_preservation_proof",
    "current_compatibility_status_after",
    "provenance",
    "non_authoritative"
  ],
  "properties": {
    "manifest_schema_version": {
      "const": 1
    },
    "original_path": {
      "type": "string",
      "pattern": "^data/market-data/snapshots/.+\\.json$"
    },
    "original_blob_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "original_schema_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "current_schema_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "original_raw_schema_status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "current_compatibility_status_before": {
      "const": "FAIL"
    },
    "derived_content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "transform_version": {
      "const": "legacy-reason-classes-canonicalize-v2"
    },
    "transformed_at": {
      "type": "string",
      "format": "date-time"
    },
    "historical_first_known_time": {
      "const": "NOT_ASSERTED"
    },
    "exact_changed_json_pointers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^/coverage/reason_classes/(?:[^/~]|~[01])+$"
      }
    },
    "before_values": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^/coverage/reason_classes/(?:[^/~]|~[01])+$": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "after_values": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^/coverage/reason_classes/(?:[^/~]|~[01])+$": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "semantic_preservation_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duplicate_free_sorted_unique_arrays",
        "reason_class_sets_preserved",
        "all_non_reason_fields_equal",
        "original_raw_bytes_sha256",
        "original_raw_git_blob_sha",
        "transformed_time_is_not_historical_publication_time"
      ],
      "properties": {
        "duplicate_free_sorted_unique_arrays": {
          "const": true
        },
        "reason_class_sets_preserved": {
          "const": true
        },
        "all_non_reason_fields_equal": {
          "const": true
        },
        "original_raw_bytes_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "original_raw_git_blob_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "transformed_time_is_not_historical_publication_time": {
          "const": true
        }
      }
    },
    "current_compatibility_status_after": {
      "const": "PASS"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "store_repository",
        "store_commit",
        "transformer_repository",
        "transformer_commit"
      ],
      "properties": {
        "store_repository": {
          "const": "yuatom/stock-market-data-store"
        },
        "store_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "transformer_repository": {
          "const": "yuatom/stock-market-data"
        },
        "transformer_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "non_authoritative": {
      "const": true
    }
  }
}
