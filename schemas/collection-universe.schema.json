{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "collection-universe.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "purpose", "daily_series", "intraday", "sector_etfs", "rules"],
  "properties": {
    "schema_version": {"const": 2},
    "purpose": {"type": "string", "minLength": 1},
    "daily_series": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol", "asset_class"],
        "properties": {
          "symbol": {"type": "string", "pattern": "^[A-Z][A-Z0-9.-]*$"},
          "asset_class": {"enum": ["stocks", "etf"]},
          "ticker_effective_at": {"type": "string", "format": "date"}
        }
      }
    },
    "intraday": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "sector_etfs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "rules": {"type": "object"}
  }
}
