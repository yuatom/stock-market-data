{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "market-data-stage-snapshot.schema.json",
  "type": "object",
  "required": ["schema_version", "snapshot_id", "stage", "trade_date", "generated_at", "coverage", "data_refs", "missing"],
  "properties": {
    "schema_version": {"const": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "stage": {"enum": ["premarket", "open_15m", "open_30m", "open_60m", "close"]},
    "trade_date": {"type": "string", "format": "date"},
    "target_window": {"type": ["object", "null"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "actual_data_cutoff": {"type": ["string", "null"], "format": "date-time"},
    "coverage": {
      "type": "object",
      "properties": {
        "symbols_requested_in_increment": {"type": "integer", "minimum": 0},
        "symbols_available_in_increment": {"type": "integer", "minimum": 0},
        "symbols_missing_in_increment": {"type": "integer", "minimum": 0},
        "inherited_ref_count": {"type": "integer", "minimum": 0},
        "total_ref_count": {"type": "integer", "minimum": 0},
        "provider_counts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "reason_classes": {"$ref": "#/$defs/reason_classes"},
        "increment": {"$ref": "#/$defs/increment_coverage"},
        "stage_snapshot": {"$ref": "#/$defs/stage_snapshot_coverage"},
        "readiness": {"$ref": "#/$defs/readiness"}
      },
      "additionalProperties": true
    },
    "data_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "blob_sha"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "kind": {"type": "string"},
          "window": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "missing": {"type": "array"}
  },
  "$defs": {
    "increment_coverage": {
      "type": "object",
      "required": [
        "requested_symbol_count",
        "capture_object_count",
        "qualified_symbol_count",
        "full_window_symbol_count",
        "terminal_observation_symbol_count",
        "missing_symbols",
        "partial_symbols",
        "symbols_requested",
        "symbols_available",
        "symbols_missing",
        "complete"
      ],
      "properties": {
        "requested_symbol_count": {"type": "integer", "minimum": 0},
        "capture_object_count": {"type": "integer", "minimum": 0},
        "qualified_symbol_count": {"type": "integer", "minimum": 0},
        "full_window_symbol_count": {"type": "integer", "minimum": 0},
        "terminal_observation_symbol_count": {"type": "integer", "minimum": 0},
        "symbols_requested": {"type": "integer", "minimum": 0},
        "symbols_available": {"type": "integer", "minimum": 0},
        "symbols_missing": {"type": "integer", "minimum": 0},
        "missing_symbols": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "partial_symbols": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "reason_classes": {"$ref": "#/$defs/reason_classes"},
        "complete": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "stage_snapshot_coverage": {
      "type": "object",
      "required": [
        "requested_symbol_count",
        "capture_object_count",
        "qualified_symbol_count",
        "full_window_symbol_count",
        "terminal_observation_symbol_count",
        "missing_symbols",
        "partial_symbols",
        "symbols_required",
        "symbols_available",
        "symbols_missing",
        "complete"
      ],
      "properties": {
        "requested_symbol_count": {"type": "integer", "minimum": 0},
        "capture_object_count": {"type": "integer", "minimum": 0},
        "qualified_symbol_count": {"type": "integer", "minimum": 0},
        "full_window_symbol_count": {"type": "integer", "minimum": 0},
        "terminal_observation_symbol_count": {"type": "integer", "minimum": 0},
        "symbols_requested": {"type": "integer", "minimum": 0},
        "symbols_required": {"type": "integer", "minimum": 0},
        "symbols_available": {"type": "integer", "minimum": 0},
        "symbols_missing": {"type": "integer", "minimum": 0},
        "missing_symbols": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "partial_symbols": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "reason_classes": {"$ref": "#/$defs/reason_classes"},
        "complete": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "readiness": {
      "type": "object",
      "required": [
        "semantics",
        "target_window_end",
        "collection_started_at",
        "collection_completed_at",
        "collection_started_after_target_seconds",
        "collection_completed_after_target_seconds",
        "snapshot_generated_at",
        "snapshot_ready_at",
        "window_end_to_snapshot_ready_seconds"
      ],
      "properties": {
        "semantics": {
          "const": "collector_observed_after_prewarm_not_github_queue_or_remote_store_commit_ready"
        },
        "target_window_end": {"type": "string", "format": "date-time"},
        "collection_started_at": {"type": "string", "format": "date-time"},
        "collection_completed_at": {"type": "string", "format": "date-time"},
        "collection_started_after_target_seconds": {"type": "number"},
        "collection_completed_after_target_seconds": {"type": "number"},
        "snapshot_generated_at": {"type": ["string", "null"], "format": "date-time"},
        "snapshot_ready_at": {"type": ["string", "null"], "format": "date-time"},
        "window_end_to_snapshot_ready_seconds": {"type": ["number", "null"]}
      },
      "additionalProperties": false
    },
    "reason_classes": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "enum": [
            "success",
            "no_rows",
            "stale_rows",
            "outside_window",
            "rate_limited",
            "transport_error",
            "qualification_rejected",
            "budget_exhausted"
          ]
        },
        "uniqueItems": true
      }
    }
  },
  "additionalProperties": true
}
