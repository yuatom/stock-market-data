{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "market-data-stage-snapshot.schema.json",
  "type": "object",
  "required": ["schema_version", "snapshot_id", "stage", "trade_date", "generated_at", "coverage", "data_refs", "missing"],
  "properties": {
    "schema_version": {"const": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "stage": {"enum": ["premarket", "open_15m", "open_30m", "open_60m", "close"]},
    "trade_date": {"type": "string", "format": "date"},
    "target_window": {"type": ["object", "null"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "actual_data_cutoff": {"type": ["string", "null"], "format": "date-time"},
    "coverage": {
      "type": "object",
      "properties": {
        "symbols_requested_in_increment": {"type": "integer", "minimum": 0},
        "symbols_available_in_increment": {"type": "integer", "minimum": 0},
        "symbols_missing_in_increment": {"type": "integer", "minimum": 0},
        "inherited_ref_count": {"type": "integer", "minimum": 0},
        "total_ref_count": {"type": "integer", "minimum": 0},
        "provider_counts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "increment": {"$ref": "#/$defs/coverage_scope"},
        "stage_snapshot": {"$ref": "#/$defs/coverage_scope"},
        "readiness": {"$ref": "#/$defs/readiness"}
      },
      "additionalProperties": true
    },
    "data_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "blob_sha"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "kind": {"type": "string"},
          "window": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "missing": {"type": "array"}
  },
  "$defs": {
    "coverage_scope": {
      "type": "object",
      "required": ["symbols_requested", "symbols_available", "symbols_missing", "missing_symbols", "complete"],
      "properties": {
        "symbols_requested": {"type": "integer", "minimum": 0},
        "symbols_available": {"type": "integer", "minimum": 0},
        "symbols_missing": {"type": "integer", "minimum": 0},
        "missing_symbols": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "complete": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "readiness": {
      "type": "object",
      "required": [
        "semantics",
        "target_window_end",
        "collection_started_at",
        "collection_completed_at",
        "collection_started_after_target_seconds",
        "collection_completed_after_target_seconds"
      ],
      "properties": {
        "semantics": {
          "const": "collector_observed_after_prewarm_not_github_queue_or_remote_store_commit_ready"
        },
        "target_window_end": {"type": "string", "format": "date-time"},
        "collection_started_at": {"type": "string", "format": "date-time"},
        "collection_completed_at": {"type": "string", "format": "date-time"},
        "collection_started_after_target_seconds": {"type": "number"},
        "collection_completed_after_target_seconds": {"type": "number"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
